# Set these in Coolify -> your resource -> Environment Variables.
# SERVICE_PASSWORD_DB and SERVICE_PASSWORD_ADMIN are generated by Coolify automatically.

# Comma separated site names. Each site name MUST be the domain it is served on.
SITES=erp.example.com,hr.example.com

# Unique per bench when you deploy this repo more than once on the same server
# (keeps each bench's built image separate).
BENCH_NAME=main

# Optional: apps to install on new sites (default: every app in apps.json).
INSTALL_APPS=

# Protocol users reach the sites with (Cloudflare tunnel = https).
SITE_PROTOCOL=https

# Run "bench migrate" on existing sites on every deploy (needed after app updates).
AUTO_MIGRATE=true

GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m
